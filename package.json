{
  "name": "nesthub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:web": "cross-env NEXT_PUBLIC_APP_TARGET=web next build",
    "build:student": "cross-env NEXT_PUBLIC_APP_TARGET=student next build",
    "build:admin": "cross-env NEXT_PUBLIC_APP_TARGET=admin next build",
    "cap:student": "node scripts/cap-cli.js student",
    "cap:admin": "node scripts/cap-cli.js admin",
    "sync:student": "npm run build:student && npm run cap:student sync android",
    "sync:admin": "npm run build:admin && npm run cap:admin sync android",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.0.1",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.7",
    "lucide-react": "^0.577.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.1"
  }
}
